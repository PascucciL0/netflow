# NetFlow — variabili d'ambiente
# Copia questo file in .env.local. Senza queste variabili l'app funziona in modalità locale (demo):
# i progressi restano nel browser.

# URL del progetto Supabase (pubblico)
NEXT_PUBLIC_SUPABASE_URL=
# Chiave pubblicabile / anon (pubblica, protetta dalle policy RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MAI inserire qui la service role key con prefisso NEXT_PUBLIC_.
# Se in futuro servirà lato server (es. import amministrativo), usare un nome senza prefisso:
# SUPABASE_SERVICE_ROLE_KEY=
